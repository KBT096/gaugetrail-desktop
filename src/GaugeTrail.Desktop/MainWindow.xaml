<Window x:Class="GaugeTrail.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:charts="clr-namespace:GaugeTrail.Desktop.Controls"
        mc:Ignorable="d"
        Title="GaugeTrail Desktop"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        AllowDrop="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="4,10,4,28">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource PrimaryDarkBrush}">
                            <Viewbox Margin="10">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 2,18 L 7,12 L 11,15 L 16,6 L 22,9" />
                                    <Ellipse Width="4" Height="4" Canvas.Left="14" Canvas.Top="4"
                                             Fill="{StaticResource PrimaryBrush}" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel Margin="12,1,0,0">
                            <TextBlock Text="GaugeTrail" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="DESKTOP · 本地离线" FontSize="10" Foreground="{StaticResource PrimaryBrush}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="工作区" Style="{StaticResource MutedText}" Margin="14,0,0,8"
                               FontSize="11" FontWeight="SemiBold" />
                    <Button x:Name="DashboardNavButton" Style="{StaticResource NavButton}"
                            CommandParameter="Dashboard" Tag="Selected" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◈" Width="28" FontSize="16" />
                            <TextBlock Text="过程总览" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" CommandParameter="Data" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" Width="28" FontSize="16" />
                            <TextBlock Text="测量数据" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" CommandParameter="Alerts" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◇" Width="28" FontSize="16" />
                            <TextBlock Text="规则信号" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" CommandParameter="Actions" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" Width="28" FontSize="16" />
                            <TextBlock Text="行动闭环" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="交付" Style="{StaticResource MutedText}" Margin="14,24,0,8"
                               FontSize="11" FontWeight="SemiBold" />
                    <Button Style="{StaticResource NavButton}" CommandParameter="Reports" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↗" Width="28" FontSize="16" />
                            <TextBlock Text="报告与导出" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" CommandParameter="Settings" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Width="28" FontSize="16" />
                            <TextBlock Text="工作区设置" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Background="#0D1528">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="数据仅保存在本机" FontSize="12" />
                        </StackPanel>
                        <TextBlock Text="v0.1.0 · 作者 KBT096" Style="{StaticResource MutedText}" FontSize="11"
                                   Margin="16,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="86" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="#0D1426" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText" Text="过程总览" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock x:Name="PageSubtitleText" Text="先看证据，再决定下一步。" Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource PrimaryDarkBrush}" CornerRadius="20" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource PrimaryBrush}" Margin="0,0,7,0" />
                                <TextBlock Text="离线工作区" Foreground="{StaticResource PrimaryBrush}"
                                           FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="HeaderUpdatedText" Text="刚刚保存" Style="{StaticResource MutedText}"
                                   Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,24,28,28">
                <!-- Dashboard -->
                <Grid x:Name="DashboardPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="210" />
                    </Grid.RowDefinitions>

                    <UniformGrid Columns="4" Margin="-6,0,-6,18">
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="数据点" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="StatCountText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="当前工作区有效记录" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="过程均值" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="StatMeanText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock x:Name="StatUnitText" Text="等待数据" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="Cpk" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="StatCpkText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="过程内波动估计" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="规则信号" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="StatAlertText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="只标记窗口末端触发点" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="1" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.35*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,9,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="I-MR 过程趋势" Style="{StaticResource SectionHeading}" />
                                        <TextBlock Text="控制限来自当前数据；规格限由工作区设置。" Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource PrimaryBrush}" />
                                        <TextBlock Text="测量" Style="{StaticResource MutedText}" Margin="5,0,12,0" />
                                        <Rectangle Width="14" Height="2" Fill="{StaticResource WarningBrush}" />
                                        <TextBlock Text="控制限" Style="{StaticResource MutedText}" Margin="5,0,12,0" />
                                        <Rectangle Width="14" Height="2" Fill="{StaticResource AccentBrush}" />
                                        <TextBlock Text="规格限" Style="{StaticResource MutedText}" Margin="5,0,0,0" />
                                    </StackPanel>
                                </Grid>
                                <charts:ControlChartView x:Name="ControlChart" Grid.Row="1" Margin="0,14,0,0" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="解释卡片" Style="{StaticResource SectionHeading}" />
                                <Border Grid.Row="1" Background="#221D2D" CornerRadius="10" Padding="14" Margin="0,14,0,14">
                                    <StackPanel>
                                        <TextBlock x:Name="StateText" Text="等待数据" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{StaticResource WarningBrush}" />
                                        <TextBlock x:Name="InterpretationText" Text="载入数据后开始分析。" TextWrapping="Wrap"
                                                   Style="{StaticResource MutedText}" Margin="0,8,0,0" LineHeight="20" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="当前边界" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SpecText" Text="规格限未设置" TextWrapping="Wrap" Margin="0,7,0,0" />
                                    <TextBlock Text="提醒" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,18,0,0" />
                                    <TextBlock Text="统计信号不是根因结论。先查量具与录入，再查材料、设备和工艺变化。"
                                               TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="21" />
                                </StackPanel>
                                <Button Grid.Row="3" Content="查看全部规则信号" Style="{StaticResource SecondaryButton}"
                                        CommandParameter="Alerts" Click="Navigate_Click" Margin="0,14,0,0" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="最近信号" Style="{StaticResource SectionHeading}" />
                                    <TextBlock Text="严重度优先，其次按触发时间排序。" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="DashboardActionCountText" Text="0 个未关闭行动项"
                                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl x:Name="RecentAlertsList" Grid.Row="1" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#101A30" BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,10,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{Binding Marker}" CornerRadius="3" />
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}"
                                                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Evidence}" Style="{StaticResource MutedText}"
                                                               Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Data -->
                <Grid x:Name="DataPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="测量数据" Style="{StaticResource PageHeading}" />
                            <TextBlock Text="支持 CSV 拖放、手工补录与错误行隔离。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="导入 CSV" Style="{StaticResource PrimaryButton}" Click="ImportCsv_Click" />
                            <Button Content="恢复演示数据" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                    Click="LoadSample_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,16" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="测量值" Style="{StaticResource MutedText}" Margin="2,0,0,5" />
                                <TextBox x:Name="QuickValueTextBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="批次" Style="{StaticResource MutedText}" Margin="2,0,0,5" />
                                <TextBox x:Name="QuickBatchTextBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="备注" Style="{StaticResource MutedText}" Margin="2,0,0,5" />
                                <TextBox x:Name="QuickNoteTextBox" />
                            </StackPanel>
                            <Button Grid.Column="3" Content="记录当前时间" Style="{StaticResource PrimaryButton}"
                                    VerticalAlignment="Bottom" Click="QuickAdd_Click" />
                        </Grid>
                    </Border>

                    <DataGrid x:Name="MeasurementsGrid" Grid.Row="2" AlternationCount="2" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="170" />
                            <DataGridTextColumn Header="测量值" Binding="{Binding Value, StringFormat={}{0:0.####}}" Width="110" />
                            <DataGridTextColumn Header="批次" Binding="{Binding Batch}" Width="140" />
                            <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="150" />
                            <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Alerts -->
                <Grid x:Name="AlertsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="190" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="规则信号" Style="{StaticResource PageHeading}" />
                            <TextBlock Text="8 条规则逐条公开，系统不把统计信号包装成根因。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource PrimaryDarkBrush}" CornerRadius="12" Padding="14,9"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="AlertSummaryText" Text="0 条信号" Foreground="{StaticResource PrimaryBrush}" />
                        </Border>
                    </Grid>

                    <DataGrid x:Name="AlertsGrid" Grid.Row="1" Margin="0,20,0,16" AlternationCount="2"
                              IsReadOnly="True" SelectionChanged="AlertsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="严重度" Binding="{Binding Severity}" Width="90" />
                            <DataGridTextColumn Header="规则" Binding="{Binding Rule}" Width="250" />
                            <DataGridTextColumn Header="触发时间" Binding="{Binding Time}" Width="155" />
                            <DataGridTextColumn Header="数值" Binding="{Binding Value}" Width="100" />
                            <DataGridTextColumn Header="证据" Binding="{Binding Evidence}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SelectedAlertTitleText" Text="选择一条信号查看解释" Style="{StaticResource SectionHeading}" />
                                <TextBlock x:Name="SelectedAlertMessageText"
                                           Text="规则只负责指出窗口证据，真正的原因需要结合现场调查。"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,20,0" LineHeight="20" />
                                <TextBlock x:Name="SelectedAlertEvidenceText" Text="" Margin="0,10,20,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="CreateActionButton" Content="为此信号创建行动项"
                                    Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                                    IsEnabled="False" Click="CreateAction_Click" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Actions -->
                <Grid x:Name="ActionsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="220" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="行动闭环" Style="{StaticResource PageHeading}" />
                        <TextBlock Text="待确认 → 已确认 → 调查中 → 已采取措施 → 待关闭 → 已关闭。" Style="{StaticResource MutedText}"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <DataGrid x:Name="ActionsGrid" Grid.Row="1" Margin="0,20,0,16" AlternationCount="2"
                              IsReadOnly="True" SelectionChanged="ActionsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="行动" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="负责人" Binding="{Binding Owner}" Width="130" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="130" />
                            <DataGridTextColumn Header="更新时间" Binding="{Binding Updated}" Width="155" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,9,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="所选行动项" Style="{StaticResource SectionHeading}" />
                                <Grid Grid.Row="1" Margin="0,14,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="负责人" Style="{StaticResource MutedText}" Margin="2,0,0,5" />
                                        <TextBox x:Name="ActionOwnerTextBox" IsEnabled="False" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="验证备注" Style="{StaticResource MutedText}" Margin="2,0,0,5" />
                                        <TextBox x:Name="ActionVerificationTextBox" IsEnabled="False" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button x:Name="SaveActionButton" Content="保存说明" Style="{StaticResource SecondaryButton}"
                                            IsEnabled="False" Click="SaveAction_Click" />
                                    <Button x:Name="AdvanceActionButton" Content="推进到下一状态" Style="{StaticResource PrimaryButton}"
                                            Margin="10,0,0,0" IsEnabled="False" Click="AdvanceAction_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="最近审计记录" Style="{StaticResource SectionHeading}" />
                                <ListBox x:Name="AuditList" Grid.Row="1" Margin="0,10,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,5">
                                                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Reports -->
                <Grid x:Name="ReportsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="报告与导出" Style="{StaticResource PageHeading}" />
                        <TextBlock Text="导出的是你的本地数据副本；应用不会把工作区上传到网络。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                    <UniformGrid Grid.Row="1" Columns="3" Margin="-8,24,-8,20">
                        <Border Style="{StaticResource Card}" Margin="8">
                            <StackPanel>
                                <TextBlock Text="CSV 数据" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="标准列名、UTF-8 编码，可继续交给 Excel、脚本或其他质量工具。"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,18" LineHeight="20" />
                                <Button Content="导出 measurement.csv" Style="{StaticResource SecondaryButton}" Click="ExportCsv_Click" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8">
                            <StackPanel>
                                <TextBlock Text="Markdown 快照" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="结论、统计摘要、规则证据、行动项与解释边界，可直接进入评审记录。"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,18" LineHeight="20" />
                                <Button Content="导出 process-report.md" Style="{StaticResource PrimaryButton}" Click="ExportReport_Click" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8">
                            <StackPanel>
                                <TextBlock Text="完整工作区" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="包含规格、测量、行动和审计记录的 JSON，可归档并在以后恢复。"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,18" LineHeight="20" />
                                <Button Content="另存 workspace.json" Style="{StaticResource SecondaryButton}" Click="ExportWorkspace_Click" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="数据去向" Style="{StaticResource SectionHeading}" />
                                <TextBlock x:Name="DataPathText" Text="正在读取本地目录…" Style="{StaticResource MutedText}"
                                           Margin="0,10,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="保存采用临时文件替换，并保留最近一次 .bak；导出文件只在你选择的位置生成。"
                                           Margin="0,12,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="打开本地数据目录" Style="{StaticResource SecondaryButton}"
                                    VerticalAlignment="Center" Click="OpenDataFolder_Click" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Settings -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="工作区设置" Style="{StaticResource PageHeading}" />
                        <TextBlock Text="名称与规格限只影响当前本地工作区；控制限始终由数据计算。" Style="{StaticResource MutedText}"
                                   Margin="0,6,0,0" />

                        <Border Style="{StaticResource Card}" Margin="0,24,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="0.7*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.ColumnSpan="3">
                                    <TextBlock Text="工作区资料" Style="{StaticResource SectionHeading}" />
                                    <TextBlock Text="先用你现场真实使用的名称，报告会原样保留。" Style="{StaticResource MutedText}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,18,12,0">
                                    <TextBlock Text="工作区名称" Style="{StaticResource MutedText}" Margin="2,0,0,5" />
                                    <TextBox x:Name="WorkspaceNameTextBox" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,18,12,0">
                                    <TextBlock Text="指标名称" Style="{StaticResource MutedText}" Margin="2,0,0,5" />
                                    <TextBox x:Name="MetricNameTextBox" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,18,0,0">
                                    <TextBlock Text="单位" Style="{StaticResource MutedText}" Margin="2,0,0,5" />
                                    <TextBox x:Name="UnitTextBox" />
                                </StackPanel>
                                <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="规格下限 LSL" Style="{StaticResource MutedText}" Margin="2,0,0,5" />
                                        <TextBox x:Name="LowerSpecTextBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="目标值 Target" Style="{StaticResource MutedText}" Margin="2,0,0,5" />
                                        <TextBox x:Name="TargetTextBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                        <TextBlock Text="规格上限 USL" Style="{StaticResource MutedText}" Margin="2,0,0,5" />
                                        <TextBox x:Name="UpperSpecTextBox" />
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="保存并重新分析" Style="{StaticResource PrimaryButton}"
                                            VerticalAlignment="Bottom" Click="SaveSettings_Click" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="首版启用的 8 条透明规则" Style="{StaticResource SectionHeading}" />
                                <TextBlock Text="这些规则采用固定窗口，只标记首次触发窗口的最后一点；同一规则连续命中的重叠窗口会合并为一次信号。"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,16" />
                                <UniformGrid Columns="2">
                                    <TextBlock Text="R1 · 单点越过 3σ" Margin="0,6" />
                                    <TextBlock Text="R5 · 3 点中有 2 点越过同侧 2σ" Margin="0,6" />
                                    <TextBlock Text="R2 · 连续 9 点位于中心线同侧" Margin="0,6" />
                                    <TextBlock Text="R6 · 5 点中有 4 点越过同侧 1σ" Margin="0,6" />
                                    <TextBlock Text="R3 · 连续 6 点单调变化" Margin="0,6" />
                                    <TextBlock Text="R7 · 连续 15 点落在 ±1σ 内" Margin="0,6" />
                                    <TextBlock Text="R4 · 连续 14 点交替升降" Margin="0,6" />
                                    <TextBlock Text="R8 · 连续 8 点落在 ±1σ 外且跨两侧" Margin="0,6" />
                                </UniformGrid>
                                <Border Background="#241B28" CornerRadius="10" Padding="14" Margin="0,16,0,0">
                                    <TextBlock Text="边界：本 Demo 未宣称符合某一行业认证版本。正式用于放行判定前，应由组织根据控制图类型、抽样策略和客户要求完成验证。"
                                               Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" LineHeight="20" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
